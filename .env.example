# ---- Supabase (local dev defaults from `npx supabase start`; swap for cloud values in prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# ---- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts provider keys and OAuth tokens at rest (AES-256-GCM).
CREDENTIALS_ENCRYPTION_KEY=
# shared secret for pg_cron → /api/jobs/tick
JOBS_SECRET=

# ---- Anthropic bootstrap (optional). Preferred: add the key in Settings → AI Providers (stored encrypted).
ANTHROPIC_API_KEY=
# required when the key is org-level (not scoped to a workspace)
ANTHROPIC_WORKSPACE_ID=

# ---- Google OAuth for Gmail (Google Cloud Console → OAuth client, type "Web application")
# Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Companies House (UK registry) — free key from developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
